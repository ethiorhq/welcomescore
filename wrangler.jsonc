{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "welcomescore",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "account_id": "0ad28641fcdacb5e69211baa6aa1da7a",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "welcomescore.is-local.org",
      "custom_domain": true
    },
    {
      "pattern": "www.welcomescore.is-local.org",
      "custom_domain": true
    }
  ]
}
