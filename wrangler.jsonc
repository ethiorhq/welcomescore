{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "welcomescore",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.welcomescore.is-local.org",
    "TURNSTILE_ALLOWED_HOSTNAMES": "welcomescore.is-local.org,www.welcomescore.is-local.org,welcomescore.pages.dev,welcomescore.js.org",
    "GROQ_REVIEW_MODEL": "openai/gpt-oss-20b",
    "GEMINI_REVIEW_MODEL": "gemini-3.7-flash"
  },
  "account_id": "0ad28641fcdacb5e69211baa6aa1da7a",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "welcomescore.is-local.org",
      "custom_domain": true
    },
    {
      "pattern": "www.welcomescore.is-local.org",
      "custom_domain": true
    }
  ]
}
