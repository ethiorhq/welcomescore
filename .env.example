# Optional: increases GitHub API rate limits for repository scoring.
GITHUB_TOKEN=

# Required for Supabase-backed leaderboard persistence. Keep this key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Algofox Review Engine settings. These values are server-only and
# must never use the NEXT_PUBLIC_ prefix. With no provider key, the app uses
# its built-in deterministic evidence rules.
GROQ_API_KEY=
GROQ_REVIEW_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_REVIEW_MODEL=gemini-2.5-flash
# Use a long random value in deployment to hash review rate-limit buckets.
ALGOFOX_REVIEW_RATE_LIMIT_SALT=

# Required for anonymous Dev Lounge Realtime in the browser.
# Use the project URL and a publishable/anon key only; never expose the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
