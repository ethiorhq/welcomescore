{
  "name": "welcomescore-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "deploy:pages": "node scripts/prepare-pages.mjs && wrangler pages deploy .open-next/assets --project-name=welcomescore --branch=main --force",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "cli:build": "npm run build --workspace=@ethiorhq/welcomescore",
    "cli:test": "npm run test --workspace=@ethiorhq/welcomescore",
    "cli:check": "npm run check --workspace=@ethiorhq/welcomescore",
    "cli:pack:check": "npm run pack:check --workspace=@ethiorhq/welcomescore"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@supabase/supabase-js": "^2.112.4",
    "framer-motion": "^13.1.1",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.15.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "wrangler": "^4.59.2"
  }
}
